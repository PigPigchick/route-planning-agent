diff --git a/tests/studio_fixture.py b/tests/studio_fixture.py
new file mode 100644
--- /dev/null
+++ b/tests/studio_fixture.py
@@ -0,0 +1,50 @@
+"""Build a small synthetic project for the Node-to-RRA integration test."""
+from pathlib import Path
+import sys
+
+import geopandas as gpd
+import pymupdf
+from shapely.geometry import LineString, Polygon
+
+from road_description.io import archive_map, write_json
+
+
+def build(folder, soffice=None):
+    folder.mkdir(parents=True, exist_ok=True)
+    dataset = folder / 'gis'
+    (dataset / 'm1').mkdir(parents=True)
+    (dataset / 'm3').mkdir()
+    crs = 'EPSG:3857'
+    write_json(dataset / 'manifest.json', {'working_crs': crs})
+    write_json(dataset / 'm3/rule_config.json', {'compiled_rules': []})
+    features = gpd.GeoDataFrame(
+        {'_variant': ['primary'], 'std_level2': ['河流'], 'std_level1': ['水系'],
+         'attr_name': ['测试河流'], 'attr_src_uid': ['fixture-water']},
+        geometry=[LineString([(650, -150), (650, 900)])], crs=crs,
+    )
+    features.to_file(dataset / 'm1/standardized_features.gpkg')
+    bounds = [(-200, -200), (2000, -200), (2000, 1000), (-200, 1000)]
+    gpd.GeoDataFrame({'name': ['样例区']}, geometry=[Polygon(bounds)], crs=crs).to_file(folder / 'admin.gpkg')
+    archive_map(folder / 'seed', {'geo_meta': {'working_crs': crs, 'offset': [0, 0]}, 'planning_bounds': bounds,
+                                 'features': []})
+    with pymupdf.open() as pdf:
+        pdf.new_page().insert_text((36, 36), 'Synthetic report fixture')
+        pdf.save(folder / 'reference.pdf')
+    config = {
+        'project_root': str(Path(__file__).resolve().parents[1]), 'project_title': 'RRA 集成联调样例',
+        'dataset': str(dataset), 'admin_boundary': str(folder / 'admin.gpkg'),
+        'reference_pdf': str(folder / 'reference.pdf'), 'output_dir': str(folder / 'seed'),
+        'voltage_kv': 500, 'nearby_m': 200, 'page_start': 1, 'section_number': '3.3', 'use_satellite': False,
+        'route_source': 'kml', 'start': [0, 0], 'llm': {'enabled': False}, 'vlm': {'enabled': False},
+        'agents': {'assembly': {'include_candidate_books': False}}, 'quality_review': {'enabled': True, 'vision': False},
+    }
+    if soffice:
+        config['soffice'] = soffice
+    write_json(folder / 'project.json', config)
+    write_json(folder / 'registry.json', {'projects': [
+        {'projectId': 'RRA-INTEGRATION', 'projectVersion': 'v1', 'config': 'project.json'},
+    ]})
+
+
+if __name__ == '__main__':
+    build(Path(sys.argv[1]).resolve(), sys.argv[2] if len(sys.argv) > 2 else None)
