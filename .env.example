# 迁移配置示例：复制为 .env.local 后填写空白的 LLM_API_KEY，或在右上角设置中填写。
# 地址、模型名和参数取自本次已保存配置；不包含 API Key。
LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=
LLM_JSON_MODE=false
LLM_STREAM=true
LLM_THINKING_MODE=on

# 默认自动识别当前项目 .venv；通常无需设置 TX_PYTHON。
# 如需指定其他解释器，请填写新设备上已安装 python-docx 的 Python 绝对路径。
# TX_PYTHON=/absolute/path/to/python3
